{
  "expo": {
    "name": "BidDrop",
    "slug": "BidDrop",
    "scheme": "biddrop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/SplashScreen.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "router": {},
      "wcProjectId": "${EXPO_PUBLIC_WC_PROJECT_ID}",
      "eas": {
        "projectId": "00c4c987-ecc7-48e3-b685-b4d65f69c2a8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-font",
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.biddrop.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.biddrop.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground-2.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "biddrop"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "owner": "varsul"
  }
}
