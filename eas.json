{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "node": "20.19.4"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_POBA_API": "https://biddrop-api.onrender.com",
        "EXPO_PUBLIC_WC_PROJECT_ID": "b92dda44eb6d5eb93f09c0f995ca6956",
        "EXPO_PUBLIC_ALLOW_MATCH_TRIGGERS": "true"
      },
      "node": "20.19.4"
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "gradleCommand": ":app:bundleRelease"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_POBA_API": "https://biddrop-api.onrender.com",
        "EXPO_PUBLIC_WC_PROJECT_ID": "b92dda44eb6d5eb93f09c0f995ca6956",
        "EXPO_PUBLIC_ALLOW_MATCH_TRIGGERS": "true"
      },
      "node": "20.19.4"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      },
      "ios": {
        "appleId": "your-apple-id@example.com",
        "ascAppId": "1234567890"
      }
    }
  }
}
